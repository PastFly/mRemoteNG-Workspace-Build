new file mode 100644
index 0000000..b44d470
--- /dev/null
+++ b/mRemoteV1/UI/Menu/WorkspaceMenuStyle.cs
@@ -0,0 +1,42 @@
+using System;
+using System.ComponentModel;
+using System.Windows.Forms;
+
+namespace mRemoteNG.UI.Menu
+{
+    internal static class WorkspaceMenuStyle
+    {
+        internal static void ApplyTo(ToolStripDropDown menu)
+        {
+            if (menu == null) return;
+
+            menu.Opening -= ApplyItemSpacing;
+            menu.Opening += ApplyItemSpacing;
+        }
+
+        private static void ApplyItemSpacing(object sender, CancelEventArgs e)
+        {
+            if (e.Cancel) return;
+
+            var menu = (ToolStripDropDown)sender;
+            var owner = menu.OwnerItem?.GetCurrentParent() ?? (menu as ContextMenuStrip)?.SourceControl;
+            if (owner != null)
+                menu.Font = owner.Font;
+
+            foreach (ToolStripItem item in menu.Items)
+            {
+                var menuItem = item as ToolStripMenuItem;
+                if (menuItem == null) continue;
+
+                menuItem.Margin = new Padding(menuItem.Margin.Left, 2, menuItem.Margin.Right, 2);
+                menuItem.DropDownOpening -= ApplyToSubmenu;
+                menuItem.DropDownOpening += ApplyToSubmenu;
+            }
+        }
+
+        private static void ApplyToSubmenu(object sender, EventArgs e)
+        {
+            ApplyTo(((ToolStripMenuItem)sender).DropDown);
+        }
+    }
+}
